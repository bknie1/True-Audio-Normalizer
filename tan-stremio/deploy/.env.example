# Copy to .env and fill in, then: docker compose up -d --build

# A domain whose DNS A record points at this server (Caddy gets a cert for it).
DOMAIN=tan.example.com

# Your debrid Torrentio "Install" URL (from https://torrentio.strem.fun/configure
# with a debrid service selected). This embeds your debrid key - keep it private.
TAN_UPSTREAM=https://torrentio.strem.fun/your-config-here/manifest.json

# A random path secret so the public URL isn't open to anyone who finds it.
# The install URL becomes https://<DOMAIN>/<TAN_SECRET>/manifest.json
TAN_SECRET=change-me-to-a-long-random-string

# Sound profile: movie (default), universal, music, speech, night, game.
TAN_PROFILE=movie
